			"      ${0:<Typography variant='h1'>This page is not implemented</Typography>}",
			"    </CommonPageLayout>",
			"  );",
			"};",
			"",
			"export default ${1:New}Page;",
			"",
		],
		"description": "Create a new page component"
	},
